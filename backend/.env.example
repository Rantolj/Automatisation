# Configuration de l'application
DEBUG=False
API_VERSION=1.0.0

# Fichiers
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs

# Formats acceptés (séparés par des virgules)
ALLOWED_EXTENSIONS=.csv,.xlsx,.json,.txt
STATISTICAL_EXTENSIONS=.xlsx,.csv

# Traitement
PROCESS_TIMEOUT_SECONDS=10

# Rate limiting
RATE_LIMIT_REQUESTS_PER_WINDOW=30
RATE_LIMIT_WINDOW_SECONDS=60

# CORS - À restreindre en production
CORS_ORIGINS=*